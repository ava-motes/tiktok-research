# TikTok Research API + enrichment env for SERVER ONLY:
#   cme-user1@comm-cme-p01.moody.utexas.edu:~/tiktok_research/.env
#
# Do NOT run TikTok collection/enrichment on a laptop/Mac.
# The Mac is for SSH/development access only.
#
# GCP project (ONLY):
#   Project ID:     cfme-mediaengagment-prod
#   Project Number: 1050243555369

# TikTok Research API (OAuth client credentials)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OpenAI — classification + optional Whisper API fallback
OPENAI_API_KEY=

# --- Enrichment (server) ---
# Service account JSON on the server, e.g.:
#   /home/cme-user1/keys/tiktok-enrichment-worker.json
# Roles: BigQuery Data Editor, BigQuery Job User, Cloud Vision API User
GOOGLE_APPLICATION_CREDENTIALS=/home/cme-user1/keys/tiktok-enrichment-worker.json

GCP_PROJECT=cfme-mediaengagment-prod
BIGQUERY_PROJECT=cfme-mediaengagment-prod
BIGQUERY_DATASET=tiktok_research
BIGQUERY_LOCATION=US

VISION_ENABLED=true

# Whisper on this 4-CPU / ~3.5GB / no-GPU VM — keep small
# Prefer openai Whisper API until faster-whisper + ffmpeg are installed
WHISPER_BACKEND=openai
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
