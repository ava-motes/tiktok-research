# Secrets / local env (server `~/tiktok_research/.env` only — never commit)
# Repo layout: p1_content_creators / p2_news / p3_keywords / common / archive

# Do NOT run TikTok collection/enrichment on a laptop/Mac.
# The Mac is for SSH/development access only.
#
# GCP project (ONLY):
#   Project ID:     cfme-mediaengagment-prod
#   Project Number: 1050243555369

# TikTok Research API (OAuth client credentials)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional per-pipeline overrides (leave empty to use TIKTOK_CLIENT_* above).
# Pipeline 1 uses these if set; otherwise the keys above.
# CONTENT_CREATOR_TIKTOK_CLIENT_KEY=
# CONTENT_CREATOR_TIKTOK_CLIENT_SECRET=

# Pipeline 2 — required dedicated pair. No fallback to Pipeline 1 or Pipeline 3.
NEWS_API_CLIENT_KEY=
NEWS_API_CLIENT_SECRET=

# Pipeline 3 — required dedicated pair. No fallback to Pipeline 1 or Pipeline 2.
KEYWORD_SEARCH_API_CLIENT_KEY=
KEYWORD_SEARCH_API_CLIENT_SECRET=

# OpenAI — classification + optional Whisper API fallback
OPENAI_API_KEY=

# --- Enrichment (server) ---
# Service account JSON on the server, e.g.:
#   /home/cme-user1/keys/tiktok-enrichment-worker.json
# Roles: BigQuery Data Editor, BigQuery Job User, Cloud Vision API User
GOOGLE_APPLICATION_CREDENTIALS=/home/cme-user1/keys/tiktok-enrichment-worker.json

GCP_PROJECT=cfme-mediaengagment-prod
BIGQUERY_PROJECT=cfme-mediaengagment-prod
BIGQUERY_DATASET=tiktok_research
BIGQUERY_LOCATION=US

VISION_ENABLED=true

# Whisper on this 4-CPU / ~3.5GB / no-GPU VM — keep small
# Prefer openai Whisper API until faster-whisper + ffmpeg are installed
WHISPER_BACKEND=openai
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# UT Box (server). After BigQuery sync, upload {collection_date}.csv per pipeline.
# Shared folder: https://utexas.box.com/s/drgh994ljt4q9c8asvizbg9mmkosif41
# Preferred: one-time OAuth, then copy data/box_oauth.json to the server.
#   BOX_CLIENT_ID=
#   BOX_CLIENT_SECRET=
# CCG alternative (COMM Box Service Account / enterprise app):
#   BOX_CLIENT_ID=
#   BOX_CLIENT_SECRET=
#   BOX_ENTERPRISE_ID=
# Short-lived developer token (not for daily runs):
#   BOX_ACCESS_TOKEN=
# BOX_SHARED_LINK=https://utexas.box.com/s/drgh994ljt4q9c8asvizbg9mmkosif41
# BOX_OAUTH_STORE=data/box_oauth.json
