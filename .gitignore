# Secrets / local env
.env
.env.*
!.env.example
box_oauth.json
data/box_oauth.json

# Python
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Local data, DBs, media (never commit)
data/
audio/
*.db
*.sqlite
*.sqlite3
*.csv
!archive/discovery/config/*.csv
*.parquet
*.mp4
*.wav
*.mp3
*.webm
*.m4a

# Pipeline outputs (keep folder placeholders)
**/results/csv/*
**/results/parquet/*
**/results/summaries/*
**/logs/**
**/box/*
!**/.gitkeep
!**/logs/checkpoints/.gitkeep

# Logs / temp
*.log
*.tmp
*.temp

# Local session dumps / screenshots (never commit)
tiktok_*_screenshot.*
tiktok_*_session.txt
tiktok_*_test.txt
*_terminal_session.txt

# GCP service account keys / credentials (never commit)
**/tiktok-enrichment-worker.json
**/*service-account*.json
**/credentials.json
**/*-key.json
*.pem
